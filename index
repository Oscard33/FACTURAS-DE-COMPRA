    <p>// 3. EXTRACCIÓN AUTOMÁTICA DE DATOS DESDE PDF (SUNAT PERÚ, SIN BLOQUEOS)</p>
    <p>// =========================================================================</p>
    <p>async function extractTextFromPdfArrayBuffer(arrayBuffer) {</p>
    <p>if (!window.pdfjsLib) return &quot;&quot;;</p>
    <p>const extractPromise = (async () =&gt; {</p>
    <p>const loadingTask = pdfjsLib.getDocument({</p>
    <p>data: arrayBuffer,</p>
    <p>disableWorker: true,</p>
    <p>isEvalSupported: false</p>
    <p>});</p>
    <p>const pdf = await loadingTask.promise;</p>
    <p>let fullText = &quot;&quot;;</p>
    <p>const maxPages = Math.min(pdf.numPages, 5);</p>
    <p>for (let i = 1; i &lt;= maxPages; i++) {</p>
    <p>const page = await pdf.getPage(i);</p>
    <p>const textContent = await page.getTextContent();</p>
    <p>const pageStrings = textContent.items.map((item) =&gt; item.str);</p>
    <p>fullText += pageStrings.join(&quot; &quot;) + &quot;\n&quot;;</p>
    <p>}</p>
    <p>return fullText;</p>
    <p>})();</p>
    <p></p>
    <p>const timeoutPromise = new Promise((resolve) =&gt; setTimeout(() =&gt; resolve(&quot;&quot;), 4000));</p>
    <p>return await Promise.race([extractPromise, timeoutPromise]);</p>
    <p>}</p>
    <p></p>
    <p>function parseSpanishMonthName(name) {</p>
    <p>const map = {</p>
    <p>ene: &quot;01&quot;, enero: &quot;01&quot;,</p>
    <p>feb: &quot;02&quot;, febrero: &quot;02&quot;,</p>
    <p>mar: &quot;03&quot;, marzo: &quot;03&quot;,</p>
    <p>abr: &quot;04&quot;, abril: &quot;04&quot;,</p>
    <p>may: &quot;05&quot;, mayo: &quot;05&quot;,</p>
    <p>jun: &quot;06&quot;, junio: &quot;06&quot;,</p>
    <p>jul: &quot;07&quot;, julio: &quot;07&quot;,</p>
    <p>ago: &quot;08&quot;, agosto: &quot;08&quot;,</p>
    <p>sep: &quot;09&quot;, set: &quot;09&quot;, septiembre: &quot;09&quot;, setiembre: &quot;09&quot;,</p>
    <p>oct: &quot;10&quot;, octubre: &quot;10&quot;,</p>
    <p>nov: &quot;11&quot;, noviembre: &quot;11&quot;,</p>
    <p>dic: &quot;12&quot;, diciembre: &quot;12&quot;</p>
    <p>};</p>
    <p>return map[name.toLowerCase()] || null;</p>
    <p>}</p>
    <p></p>
    <p>function parseInvoiceMetadataFromText(text, fileName = &quot;&quot;) {</p>
    <p>const cleanText = text.replace(/\s+/g, &quot; &quot;).trim();</p>
    <p></p>
    <p>let serie = &quot;&quot;;</p>
    <p>let correlativo = &quot;&quot;;</p>
    <p>const invoiceRegexes = [</p>
    <p>/\b([FBE][A-Z0-9]{3})\s*[-–—N°#:\s]\s*0*(\d{1,10})\b/i,</p>
    <p>/FACTURA\s+ELECTR[ÓO]NICA[\s\S]{0,60}?\b([FBE][A-Z0-9]{3})\s*[-–—]\s*(\d{1,10})\b/i,</p>
    <p>/\b([FBE][0-9]{3})\s*-\s*(\d{1,10})\b/i</p>
    <p>];</p>
    <p></p>
    <p>for (const rx of invoiceRegexes) {</p>
    <p>const m = cleanText.match(rx) || fileName.match(rx);</p>
    <p>if (m) {</p>
    <p>serie = m[1].toUpperCase();</p>
    <p>correlativo = m[2];</p>
    <p>break;</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>let fecha = &quot;&quot;;</p>
    <p>const fechaContextMatch = cleanText.match(/Fecha\s*(?:de\s*)?Emisi[óo]n[\s:.-]*(\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}|\d{4}[\/\-]\d{1,2}[\/\-]\d{1,2})/i);</p>
    <p>const rawDateCandidate = fechaContextMatch ? fechaContextMatch[1] : null;</p>
    <p></p>
    <p>function normalizeDateStr(dStr) {</p>
    <p>if (!dStr) return &quot;&quot;;</p>
    <p>let m = dStr.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})$/);</p>
    <p>if (m) {</p>
    <p>return `${m[1]}-${m[2].padStart(2, &quot;0&quot;)}-${m[3].padStart(2, &quot;0&quot;)}`;</p>
    <p>}</p>
    <p>m = dStr.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);</p>
    <p>if (m) {</p>
    <p>const year = m[3].length === 2 ? `20${m[3]}` : m[3];</p>
    <p>const month = m[2].padStart(2, &quot;0&quot;);</p>
    <p>const day = m[1].padStart(2, &quot;0&quot;);</p>
    <p>if (parseInt(month, 10) &gt;= 1 &amp;&amp; parseInt(month, 10) &lt;= 12 &amp;&amp; parseInt(day, 10) &gt;= 1 &amp;&amp; parseInt(day, 10) &lt;= 31) {</p>
    <p>return `${year}-${month}-${day}`;</p>
    <p>}</p>
    <p>}</p>
    <p>return &quot;&quot;;</p>
    <p>}</p>
    <p></p>
    <p>fecha = normalizeDateStr(rawDateCandidate);</p>
    <p>if (!fecha) {</p>
    <p>const anyDate = cleanText.match(/\b(\d{1,2}[\/\-]\d{1,2}[\/\-]20\d{2})\b/) || cleanText.match(/\b(20\d{2}[\/\-]\d{1,2}[\/\-]\d{1,2})\b/);</p>
    <p>if (anyDate) fecha = normalizeDateStr(anyDate[1]);</p>
    <p>}</p>
    <p>if (!fecha) {</p>
    <p>const textDate = cleanText.match(/\b(\d{1,2})\s+de\s+([a-zA-Z]+)\s+(?:de|del)\s+(20\d{2})\b/i);</p>
    <p>if (textDate) {</p>
    <p>const mm = parseSpanishMonthName(textDate[2]);</p>
    <p>if (mm) fecha = `${textDate[3]}-${mm}-${textDate[1].padStart(2, &quot;0&quot;)}`;</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>let moneda = &quot;PEN&quot;;</p>
    <p>if (/\b(USD|US\$|D[ÓO]LARES)\b/i.test(cleanText) &amp;&amp; !/\bSOLES\b/i.test(cleanText)) {</p>
    <p>moneda = &quot;USD&quot;;</p>
    <p>}</p>
    <p></p>
    <p>let monto = 0;</p>
    <p>const totalPatterns = [</p>
    <p>/(?:IMPORTE\s+TOTAL|TOTAL\s+A\s+PAGAR|TOTAL\s+VENTA|TOTAL\s+GENERAL|TOTAL\s+FACTURA)[\s:S\/US$]*([\d,]+\.\d{2})/i,</p>
    <p>/(?:TOTAL)[\s:]*(?:S\/|US\$)?\s*([\d,]+\.\d{2})/i</p>
    <p>];</p>
    <p>for (const rx of totalPatterns) {</p>
    <p>const m = cleanText.match(rx);</p>
    <p>if (m) {</p>
    <p>const val = parseFloat(m[1].replace(/,/g, &quot;&quot;));</p>
    <p>if (!isNaN(val) &amp;&amp; val &gt; 0) {</p>
    <p>monto = val;</p>
    <p>break;</p>
    <p>}</p>
    <p>}</p>
    <p>}</p>
    <p>if (!monto) {</p>
    <p>const allAmounts = [...cleanText.matchAll(/(?:S\/|US\$)?\s*(\d{1,3}(?:,\d{3})*\.\d{2})\b/g)]</p>
    <p>.map((m) =&gt; parseFloat(m[1].replace(/,/g, &quot;&quot;)))</p>
    <p>.filter((n) =&gt; !isNaN(n) &amp;&amp; n &gt; 0 &amp;&amp; n &lt; 10000000);</p>
    <p>if (allAmounts.length &gt; 0) {</p>
    <p>monto = Math.max(...allAmounts);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>let rucProveedor = &quot;&quot;;</p>
    <p>const rucMatches = [...cleanText.matchAll(/\b((?:10|20)\d{9})\b/g)].map((m) =&gt; m[1]);</p>
    <p>if (rucMatches.length &gt; 0) {</p>
    <p>rucProveedor = rucMatches[0];</p>
    <p>}</p>
    <p></p>
    <p>let proveedor = &quot;&quot;;</p>
    <p>const companySuffixMatch = cleanText.match(/([A-ZÁÉÍÓÚÑ0-9&amp;.,\-\s]{4,75}?\b(?:S\.A\.C\.|S\.A\.|S\.R\.L\.|E\.I\.R\.L\.|S\.A\.A\.|SAC|SRL|EIRL))/);</p>
    <p>if (companySuffixMatch) {</p>
    <p>proveedor = companySuffixMatch[1].replace(/^.*?(?:RUC\s*:?\s*\d{11}|SE[ÑN]OR\(ES\)|CLIENTE)\s*/i, &quot;&quot;).trim();</p>
    <p>}</p>
    <p>if (!proveedor &amp;&amp; rucProveedor) {</p>
    <p>const beforeRuc = cleanText.split(rucProveedor)[0].trim();</p>
    <p>const words = beforeRuc.split(&quot; &quot;).slice(-6).join(&quot; &quot;).trim();</p>
    <p>if (words.length &gt;= 4) proveedor = words;</p>
    <p>}</p>
    <p></p>
    <p>return {</p>
    <p>serie,</p>
    <p>correlativo,</p>
    <p>fecha,</p>
    <p>moneda,</p>
    <p>monto,</p>
    <p>rucProveedor,</p>
    <p>proveedor</p>
    <p>};</p>
    <p>}</p>
