    <p>&lt;!-- Guía rápida para crear el enlace gratuito en Google Drive (Apps Script) --&gt;</p>
    <p>&lt;div class=&quot;sync-card&quot;&gt;</p>
    <p>&lt;div style=&quot;display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;&quot;&gt;</p>
    <p>&lt;h3 style=&quot;font-size:15.5px; font-weight:800;&quot;&gt;¿Cómo obtener tu Enlace de Sincronización gratuito con Google Drive?&lt;/h3&gt;</p>
    <p>&lt;button type=&quot;button&quot; class=&quot;btn btn-outline btn-sm&quot; onclick=&quot;copyAppsScriptCode()&quot;&gt;Copiar Código para Google Apps Script&lt;/button&gt;</p>
    <p>&lt;/div&gt;</p>
    <p>&lt;p style=&quot;font-size:13px; color:var(--text-secondary); margin-top:8px;&quot;&gt;</p>
    <p>1. Entra a &lt;strong&gt;script.google.com&lt;/strong&gt; con tu cuenta de Google &amp;rarr; &lt;strong&gt;Nuevo proyecto&lt;/strong&gt;.&lt;br&gt;</p>
    <p>2. Pega el código de abajo y haz clic en &lt;strong&gt;Implementar &amp;rarr; Nueva implementación &amp;rarr; Aplicación web&lt;/strong&gt; (Ejecutar como: &lt;em&gt;Yo&lt;/em&gt;, Quién tiene acceso: &lt;em&gt;Cualquier usuario&lt;/em&gt;).&lt;br&gt;</p>
    <p>3. Copia la &lt;strong&gt;URL de la aplicación web&lt;/strong&gt; que te entrega Google y pégala arriba en &lt;em&gt;Enlace de Sincronización&lt;/em&gt; en tu iPad y en la PC de tu compañero. ¡Guarda los PDFs directo en tu Google Drive!</p>
    <p>&lt;/p&gt;</p>
    <p>&lt;div class=&quot;code-box&quot; id=&quot;appsScriptSnippet&quot;&gt;// Código Google Apps Script para Sincronizar Facturas PDF + Validación SIRE</p>
    <p>function doGet(e) {</p>
    <p>var folder = getOrCreateFolder_(&quot;SuministrosElectricOz_FacturasCompra&quot;);</p>
    <p>var dbFile = getOrCreateDbFile_(folder);</p>
    <p>var data = JSON.parse(dbFile.getBlob().getDataAsString() || &#39;{&quot;invoices&quot;:[],&quot;validation&quot;:null}&#39;);</p>
    <p>return ContentService.createTextOutput(JSON.stringify({ ok: true, data: data }))</p>
    <p>.setMimeType(ContentService.MimeType.JSON);</p>
    <p>}</p>
    <p></p>
    <p>function doPost(e) {</p>
    <p>var payload = JSON.parse(e.postData.contents);</p>
    <p>var folder = getOrCreateFolder_(&quot;SuministrosElectricOz_FacturasCompra&quot;);</p>
    <p>var dbFile = getOrCreateDbFile_(folder);</p>
    <p>var db = JSON.parse(dbFile.getBlob().getDataAsString() || &#39;{&quot;invoices&quot;:[],&quot;validation&quot;:null}&#39;);</p>
    <p></p>
    <p>if (payload.action === &quot;UPSERT_INVOICE&quot; &amp;&amp; payload.invoice) {</p>
    <p>var inv = payload.invoice;</p>
    <p>var idx = -1;</p>
    <p>for (var i = 0; i &lt; db.invoices.length; i++) {</p>
    <p>if (db.invoices[i].normalizedKey === inv.normalizedKey) { idx = i; break; }</p>
    <p>}</p>
    <p>if (inv.pdfBase64) {</p>
    <p>var bytes = Utilities.base64Decode(inv.pdfBase64.split(&quot;,&quot;).pop());</p>
    <p>var blob = Utilities.newBlob(bytes, &quot;application/pdf&quot;, inv.fileName || (inv.normalizedKey + &quot;.pdf&quot;));</p>
    <p>var savedPdf = folder.createFile(blob);</p>
    <p>savedPdf.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);</p>
    <p>inv.driveFileId = savedPdf.getId();</p>
    <p>delete inv.pdfBase64;</p>
    <p>}</p>
    <p>if (idx !== -1) {</p>
    <p>inv.driveFileId = inv.driveFileId || db.invoices[idx].driveFileId;</p>
    <p>db.invoices[idx] = inv;</p>
    <p>} else {</p>
    <p>db.invoices.push(inv);</p>
    <p>}</p>
    <p>} else if (payload.action === &quot;DELETE_INVOICE&quot; &amp;&amp; payload.id) {</p>
    <p>db.invoices = db.invoices.filter(function(x) { return x.id !== payload.id; });</p>
    <p>} else if (payload.action === &quot;SAVE_VALIDATION&quot;) {</p>
    <p>db.validation = payload.validation;</p>
    <p>} else if (payload.action === &quot;FULL_SYNC&quot; &amp;&amp; payload.data) {</p>
    <p>db = payload.data;</p>
    <p>}</p>
    <p></p>
    <p>dbFile.setContent(JSON.stringify(db));</p>
    <p>return ContentService.createTextOutput(JSON.stringify({ ok: true, data: db }))</p>
    <p>.setMimeType(ContentService.MimeType.JSON);</p>
    <p>}</p>
    <p></p>
    <p>function getOrCreateFolder_(name) {</p>
    <p>var it = DriveApp.getFoldersByName(name);</p>
    <p>return it.hasNext() ? it.next() : DriveApp.createFolder(name);</p>
    <p>}</p>
    <p></p>
    <p>function getOrCreateDbFile_(folder) {</p>
    <p>var it = folder.getFilesByName(&quot;database_compras_sire.json&quot;);</p>
    <p>return it.hasNext() ? it.next() : folder.createFile(&quot;database_compras_sire.json&quot;, &#39;{&quot;invoices&quot;:[],&quot;validation&quot;:null}&#39;, MimeType.PLAIN_TEXT);</p>
    <p>}&lt;/div&gt;</p>
