    <p>function normalizeInvoiceParts(rawSerie, rawCorrelativo, rawRuc = &quot;&quot;) {</p>
    <p>const serie = String(rawSerie || &quot;&quot;).trim().toUpperCase().replace(/[^A-Z0-9]/g, &quot;&quot;);</p>
    <p>const digitsOnly = String(rawCorrelativo || &quot;&quot;).trim().replace(/[^0-9]/g, &quot;&quot;);</p>
    <p>const correlativoNum = digitsOnly ? parseInt(digitsOnly, 10) : 0;</p>
    <p>const paddedCorrelativo = digitsOnly ? digitsOnly.padStart(8, &quot;0&quot;) : &quot;00000000&quot;;</p>
    <p>const normalizedCode = `${serie}-${correlativoNum}`;</p>
    <p>const cleanRuc = String(rawRuc || &quot;&quot;).trim().replace(/[^0-9]/g, &quot;&quot;);</p>
    <p>const normalizedKey = cleanRuc.length === 11 ? `${cleanRuc}|${normalizedCode}` : normalizedCode;</p>
    <p>return {</p>
    <p>serie,</p>
    <p>correlativoOriginal: digitsOnly || rawCorrelativo,</p>
    <p>correlativoNum,</p>
    <p>paddedCorrelativo,</p>
    <p>normalizedCode,</p>
    <p>cleanRuc,</p>
    <p>normalizedKey</p>
    <p>};</p>
    <p>}</p>
    <p></p>
    <p>function findDuplicateInvoice(serie, correlativo, ruc = &quot;&quot;, excludeId = null) {</p>
    <p>const target = normalizeInvoiceParts(serie, correlativo, ruc);</p>
    <p>return state.invoices.find((inv) =&gt; {</p>
    <p>if (excludeId &amp;&amp; inv.id === excludeId) return false;</p>
    <p>const existing = normalizeInvoiceParts(inv.serie, inv.correlativo, inv.rucProveedor);</p>
    <p>if (existing.normalizedCode === target.normalizedCode) {</p>
    <p>if (!existing.cleanRuc || !target.cleanRuc || existing.cleanRuc === target.cleanRuc) {</p>
    <p>return true;</p>
    <p>}</p>
    <p>}</p>
    <p>return false;</p>
    <p>});</p>
    <p>}</p>
