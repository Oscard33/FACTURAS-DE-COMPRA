    <p>const tx = db.transaction(&quot;kv&quot;, &quot;readwrite&quot;);</p>
    <p>const req = tx.objectStore(&quot;kv&quot;).put(val, key);</p>
    <p>req.onsuccess = () =&gt; resolve();</p>
    <p>req.onerror = () =&gt; reject(req.error);</p>
    <p>});</p>
    <p>} catch (e) {</p>
    <p>try {</p>
    <p>localStorage.setItem(&quot;fallback_&quot; + key, JSON.stringify(val));</p>
    <p>} catch (err) {</p>
    <p>console.warn(&quot;Storage warning:&quot;, err);</p>
    <p>}</p>
    <p>}</p>
    <p>}</p>
