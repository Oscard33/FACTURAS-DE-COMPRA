    <p></p>
    <p>function detectCsvDelimiter(headerLine) {</p>
    <p>const candidates = [&quot;|&quot;, &quot;;&quot;, &quot;,&quot;, &quot;\t&quot;];</p>
    <p>let best = &quot;,&quot;;</p>
    <p>let maxCount = 0;</p>
    <p>for (const c of candidates) {</p>
    <p>const count = headerLine.split(c).length - 1;</p>
    <p>if (count &gt; maxCount) {</p>
    <p>maxCount = count;</p>
    <p>best = c;</p>
    <p>}</p>
    <p>}</p>
    <p>return best;</p>
    <p>}</p>
    <p></p>
    <p>function splitCsvRow(line, delimiter) {</p>
    <p>const result = [];</p>
    <p>let current = &quot;&quot;;</p>
    <p>let inQuotes = false;</p>
    <p>for (let i = 0; i &lt; line.length; i++) {</p>
    <p>const ch = line[i];</p>
    <p>if (ch === &#39;&quot;&#39;) {</p>
    <p>inQuotes = !inQuotes;</p>
    <p>} else if (ch === delimiter &amp;&amp; !inQuotes) {</p>
    <p>result.push(current.trim());</p>
    <p>current = &quot;&quot;;</p>
    <p>} else {</p>
    <p>current += ch;</p>
    <p>}</p>
    <p>}</p>
    <p>result.push(current.trim());</p>
    <p>return result;</p>
    <p>}</p>
    <p></p>
    <p>function parseSireCsvContent(csvText) {</p>
    <p>const lines = csvText.split(/\r?\n/).map((l) =&gt; l.trim()).filter((l) =&gt; l.length &gt; 0);</p>
    <p>if (lines.length &lt; 2) return [];</p>
    <p></p>
    <p>let headerIdx = 0;</p>
    <p>for (let i = 0; i &lt; Math.min(lines.length, 10); i++) {</p>
    <p>const low = lines[i].toLowerCase();</p>
    <p>if ((low.includes(&quot;serie&quot;) || low.includes(&quot;cdp&quot;) || low.includes(&quot;comprobante&quot;)) &amp;&amp; (low.includes(&quot;total&quot;) || low.includes(&quot;fecha&quot;) || low.includes(&quot;ruc&quot;))) {</p>
    <p>headerIdx = i;</p>
    <p>break;</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>const delimiter = detectCsvDelimiter(lines[headerIdx]);</p>
    <p>const headers = splitCsvRow(lines[headerIdx], delimiter).map((h) =&gt; h.toLowerCase());</p>
    <p></p>
    <p>const idxRuc = headers.findIndex((h) =&gt; h.includes(&quot;ruc&quot;) || h.includes(&quot;nro doc identidad&quot;));</p>
    <p>const idxRazon = headers.findIndex((h) =&gt; h.includes(&quot;razon&quot;) || h.includes(&quot;razón&quot;) || h.includes(&quot;apellidos&quot;) || h.includes(&quot;proveedor&quot;));</p>
    <p>const idxFecha = headers.findIndex((h) =&gt; h.includes(&quot;fecha de emision&quot;) || h.includes(&quot;fecha de emisión&quot;) || h.includes(&quot;fecha emision&quot;) || h.includes(&quot;fecha&quot;));</p>
    <p>const idxSerie = headers.findIndex((h) =&gt; h.includes(&quot;serie&quot;));</p>
    <p>const idxNumero = headers.findIndex((h) =&gt; h.includes(&quot;nro cp&quot;) || h.includes(&quot;numero&quot;) || h.includes(&quot;número&quot;) || h.includes(&quot;correlativo&quot;) || h.includes(&quot;nro inicial&quot;));</p>
    <p>const idxTotal = headers.findIndex((h) =&gt; h.includes(&quot;total cp&quot;) || h.includes(&quot;importe total&quot;) || h === &quot;total&quot; || h.includes(&quot;monto total&quot;));</p>
    <p>const idxMoneda = headers.findIndex((h) =&gt; h.includes(&quot;moneda&quot;));</p>
    <p>const idxTipo = headers.findIndex((h) =&gt; h.includes(&quot;tipo cp&quot;) || h.includes(&quot;tipo doc&quot;));</p>
    <p></p>
    <p>const records = [];</p>
    <p>for (let i = headerIdx + 1; i &lt; lines.length; i++) {</p>
    <p>const cols = splitCsvRow(lines[i], delimiter);</p>
    <p>if (cols.length &lt; 3) continue;</p>
    <p></p>
    <p>let serie = idxSerie !== -1 ? (cols[idxSerie] || &quot;&quot;) : &quot;&quot;;</p>
    <p>let numero = idxNumero !== -1 ? (cols[idxNumero] || &quot;&quot;) : &quot;&quot;;</p>
    <p></p>
    <p>if (serie.includes(&quot;-&quot;) &amp;&amp; !numero) {</p>
    <p>const parts = serie.split(&quot;-&quot;);</p>
    <p>serie = parts[0];</p>
    <p>numero = parts[1];</p>
    <p>}</p>
    <p></p>
    <p>if (!serie || !numero) {</p>
    <p>for (let c = 0; c &lt; cols.length; c++) {</p>
    <p>const m = cols[c].match(/^([FBE][A-Z0-9]{3})-0*(\d+)$/i);</p>
    <p>if (m) {</p>
    <p>serie = m[1];</p>
    <p>numero = m[2];</p>
    <p>break;</p>
    <p>}</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>if (!serie || !numero) continue;</p>
    <p></p>
    <p>const tipoDoc = idxTipo !== -1 ? (cols[idxTipo] || &quot;&quot;) : &quot;&quot;;</p>
    <p>const ruc = idxRuc !== -1 ? (cols[idxRuc] || &quot;&quot;).replace(/[^0-9]/g, &quot;&quot;) : &quot;&quot;;</p>
    <p>const proveedor = idxRazon !== -1 ? (cols[idxRazon] || &quot;PROVEEDOR SIRE&quot;) : &quot;PROVEEDOR SIRE&quot;;</p>
    <p>const rawFecha = idxFecha !== -1 ? (cols[idxFecha] || &quot;&quot;) : &quot;&quot;;</p>
    <p>const moneda = idxMoneda !== -1 &amp;&amp; /USD|DOLAR/i.test(cols[idxMoneda] || &quot;&quot;) ? &quot;USD&quot; : &quot;PEN&quot;;</p>
    <p></p>
    <p>let monto = 0;</p>
    <p>if (idxTotal !== -1 &amp;&amp; cols[idxTotal]) {</p>
    <p>monto = Math.abs(parseFloat(cols[idxTotal].replace(/[^0-9.-]/g, &quot;&quot;)) || 0);</p>
    <p>}</p>
    <p></p>
    <p>const norm = normalizeInvoiceParts(serie, numero, ruc);</p>
    <p>records.push({</p>
    <p>tipoDoc,</p>
    <p>serie: norm.serie,</p>
    <p>correlativo: numero,</p>
    <p>normalizedCode: norm.normalizedCode,</p>
    <p>normalizedKey: norm.normalizedKey,</p>
    <p>ruc,</p>
    <p>proveedor: proveedor.toUpperCase(),</p>
    <p>fecha: rawFecha,</p>
    <p>moneda,</p>
    <p>monto</p>
    <p>});</p>
    <p>}</p>
    <p></p>
    <p>return records;</p>
    <p>}</p>
    <p></p>
    <p>function evaluateSireValidation(sireRecords, fileName, silent = false) {</p>
    <p>const uploadedByCode = new Map();</p>
    <p>state.invoices.forEach((inv) =&gt; {</p>
    <p>uploadedByCode.set(inv.normalizedCode, inv);</p>
    <p>});</p>
    <p></p>
    <p>const evaluatedItems = sireRecords.map((rec) =&gt; {</p>
    <p>const found = uploadedByCode.has(rec.normalizedCode);</p>
    <p>return {</p>
    <p>...rec,</p>
    <p>status: found ? &quot;MATCHED&quot; : &quot;MISSING&quot;</p>
    <p>};</p>
    <p>});</p>
    <p></p>
    <p>const missingItems = evaluatedItems.filter((x) =&gt; x.status === &quot;MISSING&quot;);</p>
    <p>const matchedItems = evaluatedItems.filter((x) =&gt; x.status === &quot;MATCHED&quot;);</p>
    <p></p>
    <p>const totalSire = evaluatedItems.length;</p>
    <p>const missingCount = missingItems.length;</p>
    <p>const missingPercent = totalSire &gt; 0 ? ((missingCount / totalSire) * 100) : 0;</p>
    <p></p>
    <p>const missingAmountPEN = missingItems</p>
    <p>.filter((x) =&gt; x.moneda !== &quot;USD&quot;)</p>
    <p>.reduce((acc, x) =&gt; acc + x.monto, 0);</p>
    <p></p>
    <p>const missingAmountUSD = missingItems</p>
    <p>.filter((x) =&gt; x.moneda === &quot;USD&quot;)</p>
    <p>.reduce((acc, x) =&gt; acc + x.monto, 0);</p>
    <p></p>
    <p>state.validation = {</p>
    <p>fileName,</p>
    <p>evaluatedAt: new Date().toISOString(),</p>
    <p>totalSire,</p>
    <p>matchedCount: matchedItems.length,</p>
    <p>missingCount,</p>
    <p>missingPercent,</p>
    <p>missingAmountPEN,</p>
    <p>missingAmountUSD,</p>
    <p>matchedNormalizedCodes: matchedItems.map((x) =&gt; x.normalizedCode),</p>
    <p>items: evaluatedItems</p>
    <p>};</p>
    <p></p>
    <p>if (!silent &amp;&amp; missingCount &gt; 0) {</p>
    <p>showAlert(</p>
    <p>&quot;error&quot;,</p>
    <p>`ALERTA SIRE: Faltan ${missingCount} de ${totalSire} facturas (${missingPercent.toFixed(1)}%) por subir en PDF, representando un monto total de ${formatMoney(missingAmountPEN, &quot;PEN&quot;)}${missingAmountUSD &gt; 0 ? &quot; + &quot; + formatMoney(missingAmountUSD, &quot;USD&quot;) : &quot;&quot;}.`</p>
    <p>);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>function reRunLastValidation(silent = false) {</p>
    <p>if (!state.validation || !state.validation.items) return;</p>
    <p>evaluateSireValidation(state.validation.items, state.validation.fileName, silent);</p>
    <p>persistState();</p>
