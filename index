    <p>function readFileAsArrayBufferSafe(file) {</p>
    <p>if (typeof file.arrayBuffer === &quot;function&quot;) {</p>
    <p>return file.arrayBuffer();</p>
    <p>}</p>
    <p>return new Promise((resolve, reject) =&gt; {</p>
    <p>const reader = new FileReader();</p>
    <p>reader.onload = () =&gt; resolve(reader.result);</p>
    <p>reader.onerror = () =&gt; reject(reader.error);</p>
    <p>reader.readAsArrayBuffer(file);</p>
    <p>});</p>
    <p>}</p>
    <p></p>
    <p>function arrayBufferToBase64(buffer) {</p>
    <p>let binary = &quot;&quot;;</p>
    <p>const bytes = new Uint8Array(buffer);</p>
    <p>const len = bytes.byteLength;</p>
    <p>const chunkSize = 0x8000;</p>
    <p>for (let i = 0; i &lt; len; i += chunkSize) {</p>
    <p>binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize));</p>
    <p>}</p>
    <p>return &quot;data:application/pdf;base64,&quot; + btoa(binary);</p>
    <p>}</p>
    <p></p>
    <p>async function handlePdfFilesUpload(fileList) {</p>
    <p>const files = Array.from(fileList);</p>
    <p>const progressEl = document.getElementById(&quot;uploadProgressMsg&quot;);</p>
    <p>progressEl.style.display = &quot;block&quot;;</p>
    <p>progressEl.textContent = `Leyendo ${files.length} archivo(s)...`;</p>
    <p></p>
    <p>let addedCount = 0;</p>
    <p></p>
    <p>for (let i = 0; i &lt; files.length; i++) {</p>
    <p>const file = files[i];</p>
    <p>progressEl.textContent = `Procesando PDF ${i + 1} de ${files.length}: ${file.name}...`;</p>
    <p></p>
    <p>const isPdf = file.type === &quot;application/pdf&quot; || file.name.toLowerCase().endsWith(&quot;.pdf&quot;);</p>
    <p>if (!isPdf) {</p>
    <p>showAlert(&quot;error&quot;, `Archivo rechazado (${file.name}): Este sistema solo acepta comprobantes en formato PDF.`);</p>
    <p>continue;</p>
    <p>}</p>
    <p></p>
    <p>try {</p>
    <p>const arrayBuffer = await readFileAsArrayBufferSafe(file);</p>
    <p>const pdfBase64 = arrayBufferToBase64(arrayBuffer);</p>
    <p>let parsed = { serie: &quot;&quot;, correlativo: &quot;&quot;, fecha: &quot;&quot;, moneda: &quot;PEN&quot;, monto: 0, rucProveedor: &quot;&quot;, proveedor: &quot;&quot; };</p>
    <p></p>
    <p>try {</p>
    <p>const extractedText = await extractTextFromPdfArrayBuffer(arrayBuffer.slice(0));</p>
    <p>parsed = parseInvoiceMetadataFromText(extractedText, file.name);</p>
    <p>} catch (pdfParseErr) {</p>
    <p>console.warn(&quot;Extracción automática omitida, se solicitará confirmación manual:&quot;, pdfParseErr);</p>
    <p>}</p>
    <p></p>
    <p>if (parsed.serie &amp;&amp; parsed.correlativo &amp;&amp; parsed.fecha &amp;&amp; parsed.monto &gt; 0 &amp;&amp; parsed.proveedor) {</p>
    <p>const dup = findDuplicateInvoice(parsed.serie, parsed.correlativo, parsed.rucProveedor);</p>
    <p>if (dup) {</p>
    <p>const norm = normalizeInvoiceParts(parsed.serie, parsed.correlativo);</p>
    <p>showAlert(</p>
    <p>&quot;error&quot;,</p>
    <p>`FACTURA DUPLICADA BLOQUEADA (${file.name}): El comprobante ${parsed.serie}-${parsed.correlativo} (equivalente a ${norm.normalizedCode}) ya fue registrado anteriormente el ${formatDateShort(dup.fecha)} por ${dup.proveedor}. No se sumó al mes.`</p>
    <p>);</p>
    <p>continue;</p>
    <p>}</p>
    <p></p>
    <p>const newInvoice = buildInvoiceObject({</p>
    <p>...parsed,</p>
    <p>pdfBase64,</p>
    <p>fileName: file.name</p>
    <p>});</p>
    <p></p>
    <p>state.invoices.push(newInvoice);</p>
    <p>addedCount++;</p>
    <p>pushInvoiceToCloud(newInvoice);</p>
    <p>} else {</p>
    <p>state.pendingPdfQueue.push({</p>
    <p>pdfBase64,</p>
    <p>fileName: file.name,</p>
    <p>parsed</p>
    <p>});</p>
    <p>}</p>
