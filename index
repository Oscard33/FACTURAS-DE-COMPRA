    <p>&lt;span class=&quot;sub-text&quot;&gt;${item.ruc ? &quot;RUC: &quot; + item.ruc : &quot;&quot;}&lt;/span&gt;</p>
    <p>&lt;/td&gt;</p>
    <p>&lt;td&gt;&lt;strong&gt;${formatMoney(item.monto, item.moneda)}&lt;/strong&gt;&lt;/td&gt;</p>
    <p>&lt;/tr&gt;</p>
    <p>`;</p>
    <p>}).join(&quot;&quot;);</p>
    <p>}</p>
    <p></p>
    <p>// =========================================================================</p>
    <p>// 9. SINCRONIZACIÓN EN LA NUBE (ENLACE COMPARTIDO TABLET &lt;-&gt; PC COMPAÑERO)</p>
    <p>// =========================================================================</p>
    <p>function isFirebaseUrl(url) {</p>
    <p>return /firebaseio\.com|firebasedatabase\.app/i.test(url);</p>
    <p>}</p>
    <p></p>
    <p>async function saveSyncSettings() {</p>
    <p>const companyName = document.getElementById(&quot;cfgCompanyName&quot;).value.trim() || &quot;Suministros ElectricOz&quot;;</p>
    <p>const userName = document.getElementById(&quot;cfgUserName&quot;).value.trim() || &quot;Usuario&quot;;</p>
    <p>const syncUrl = document.getElementById(&quot;cfgSyncUrl&quot;).value.trim();</p>
    <p></p>
    <p>state.settings = { companyName, userName, syncUrl };</p>
    <p>await persistState();</p>
    <p>updateHeaderAndBadges();</p>
    <p></p>
    <p>if (syncUrl) {</p>
    <p>await syncWithCloud(true);</p>
    <p>} else {</p>
    <p>showAlert(&quot;success&quot;, &quot;Configuración local guardada correctamente.&quot;);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>async function disconnectCloud() {</p>
    <p>state.settings.syncUrl = &quot;&quot;;</p>
    <p>document.getElementById(&quot;cfgSyncUrl&quot;).value = &quot;&quot;;</p>
    <p>await persistState();</p>
    <p>updateHeaderAndBadges();</p>
    <p>showAlert(&quot;warning&quot;, &quot;Enlace de nube desconectado. El sistema sigue funcionando localmente.&quot;);</p>
    <p>}</p>
    <p></p>
    <p>async function syncWithCloud(showFeedback = false) {</p>
    <p>const url = (state.settings.syncUrl || &quot;&quot;).trim();</p>
    <p>if (!url) return;</p>
    <p></p>
    <p>const dot = document.getElementById(&quot;syncStatusDot&quot;);</p>
    <p>const txt = document.getElementById(&quot;syncStatusText&quot;);</p>
    <p>dot.className = &quot;dot syncing&quot;;</p>
    <p>txt.textContent = &quot;Sincronizando...&quot;;</p>
    <p></p>
    <p>try {</p>
    <p>let remoteData = null;</p>
    <p></p>
    <p>if (isFirebaseUrl(url)) {</p>
    <p>const cleanBase = url.replace(/\/+$/, &quot;&quot;);</p>
    <p>const getRes = await fetch(`${cleanBase}/compras_sire_db.json`);</p>
    <p>remoteData = await getRes.json();</p>
    <p>} else {</p>
    <p>const getRes = await fetch(url);</p>
    <p>const json = await getRes.json();</p>
    <p>remoteData = json.data || json;</p>
    <p>}</p>
    <p></p>
    <p>const mergedMap = new Map();</p>
    <p>const remoteInvoices = (remoteData &amp;&amp; Array.isArray(remoteData.invoices)) ? remoteData.invoices : [];</p>
    <p>remoteInvoices.forEach((inv) =&gt; mergedMap.set(inv.normalizedCode, inv));</p>
    <p>state.invoices.forEach((localInv) =&gt; {</p>
    <p>const existing = mergedMap.get(localInv.normalizedCode);</p>
    <p>if (!existing || (!existing.pdfBase64 &amp;&amp; localInv.pdfBase64)) {</p>
    <p>mergedMap.set(localInv.normalizedCode, localInv);</p>
    <p>}</p>
    <p>});</p>
    <p></p>
    <p>state.invoices = Array.from(mergedMap.values());</p>
    <p></p>
    <p>if (remoteData &amp;&amp; remoteData.validation) {</p>
    <p>if (!state.validation || new Date(remoteData.validation.evaluatedAt) &gt; new Date(state.validation.evaluatedAt)) {</p>
    <p>state.validation = remoteData.validation;</p>
    <p>}</p>
    <p>}</p>
    <p>if (state.validation) {</p>
    <p>reRunLastValidation(true);</p>
    <p>}</p>
    <p></p>
    <p>if (isFirebaseUrl(url)) {</p>
    <p>const cleanBase = url.replace(/\/+$/, &quot;&quot;);</p>
    <p>const lightInvoices = state.invoices.map((x) =&gt; {</p>
    <p>const copy = { ...x };</p>
    <p>if (copy.pdfBase64 &amp;&amp; copy.pdfBase64.length &gt; 600000) {</p>
    <p>delete copy.pdfBase64;</p>
    <p>}</p>
    <p>return copy;</p>
    <p>});</p>
    <p>await fetch(`${cleanBase}/compras_sire_db.json`, {</p>
    <p>method: &quot;PUT&quot;,</p>
    <p>headers: { &quot;Content-Type&quot;: &quot;application/json&quot; },</p>
    <p>body: JSON.stringify({</p>
    <p>invoices: lightInvoices,</p>
    <p>validation: state.validation</p>
    <p>})</p>
    <p>});</p>
    <p>} else {</p>
    <p>for (const inv of state.invoices) {</p>
    <p>const inRemote = remoteInvoices.some((r) =&gt; r.normalizedCode === inv.normalizedCode);</p>
    <p>if (!inRemote) {</p>
    <p>await pushInvoiceToCloud(inv);</p>
    <p>}</p>
    <p>}</p>
    <p>if (state.validation) {</p>
    <p>await pushValidationToCloud(state.validation);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>await persistState();</p>
    <p>renderAll();</p>
    <p></p>
    <p>dot.className = &quot;dot online&quot;;</p>
    <p>txt.textContent = `Sincronizado (${state.settings.userName})`;</p>
    <p>if (showFeedback) {</p>
    <p>showAlert(&quot;success&quot;, `Sincronización completada. Total en equipo: ${state.invoices.length} facturas.`);</p>
    <p>}</p>
    <p>} catch (err) {</p>
    <p>console.error(err);</p>
    <p>dot.className = &quot;dot&quot;;</p>
    <p>txt.textContent = &quot;Error de conexión nube&quot;;</p>
    <p>if (showFeedback) {</p>
    <p>showAlert(&quot;error&quot;, &quot;No se pudo conectar con el enlace de sincronización. Verifica la URL y los permisos de acceso.&quot;);</p>
    <p>}</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>async function pushInvoiceToCloud(invoice) {</p>
    <p>const url = (state.settings.syncUrl || &quot;&quot;).trim();</p>
    <p>if (!url) return;</p>
    <p>try {</p>
    <p>if (isFirebaseUrl(url)) {</p>
    <p>await syncWithCloud(false);</p>
    <p>} else {</p>
    <p>await fetch(url, {</p>
    <p>method: &quot;POST&quot;,</p>
    <p>body: JSON.stringify({</p>
    <p>action: &quot;UPSERT_INVOICE&quot;,</p>
    <p>invoice</p>
    <p>})</p>
    <p>});</p>
    <p>}</p>
    <p>} catch (e) {</p>
    <p>console.warn(&quot;Pendiente de sincronizar luego:&quot;, e);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>async function deleteInvoiceFromCloud(id) {</p>
    <p>const url = (state.settings.syncUrl || &quot;&quot;).trim();</p>
    <p>if (!url) return;</p>
    <p>try {</p>
    <p>if (isFirebaseUrl(url)) {</p>
    <p>await syncWithCloud(false);</p>
    <p>} else {</p>
    <p>await fetch(url, {</p>
    <p>method: &quot;POST&quot;,</p>
    <p>body: JSON.stringify({</p>
    <p>action: &quot;DELETE_INVOICE&quot;,</p>
    <p>id</p>
    <p>})</p>
    <p>});</p>
    <p>}</p>
    <p>} catch (e) {</p>
    <p>console.warn(e);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>async function pushValidationToCloud(validation) {</p>
    <p>const url = (state.settings.syncUrl || &quot;&quot;).trim();</p>
    <p>if (!url) return;</p>
    <p>try {</p>
    <p>if (isFirebaseUrl(url)) {</p>
    <p>await syncWithCloud(false);</p>
    <p>} else {</p>
    <p>await fetch(url, {</p>
    <p>method: &quot;POST&quot;,</p>
    <p>body: JSON.stringify({</p>
    <p>action: &quot;SAVE_VALIDATION&quot;,</p>
    <p>validation</p>
    <p>})</p>
    <p>});</p>
    <p>}</p>
    <p>} catch (e) {</p>
    <p>console.warn(e);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>function exportFullBackup() {</p>
    <p>const payload = {</p>
    <p>exportedAt: new Date().toISOString(),</p>
    <p>companyName: state.settings.companyName,</p>
    <p>invoices: state.invoices,</p>
    <p>validation: state.validation</p>
    <p>};</p>
    <p>const blob = new Blob([JSON.stringify(payload)], { type: &quot;application/json&quot; });</p>
    <p>const url = URL.createObjectURL(blob);</p>
    <p>const a = document.createElement(&quot;a&quot;);</p>
    <p>a.href = url;</p>
    <p>a.download = `Respaldo_Compras_SIRE_${new Date().toISOString().slice(0, 10)}.json`;</p>
    <p>a.click();</p>
    <p>URL.revokeObjectURL(url);</p>
    <p>}</p>
    <p></p>
    <p>document.getElementById(&quot;backupFileInput&quot;).addEventListener(&quot;change&quot;, async (e) =&gt; {</p>
    <p>const file = e.target.files &amp;&amp; e.target.files[0];</p>
    <p>if (!file) return;</p>
    <p>e.target.value = &quot;&quot;;</p>
    <p>try {</p>
    <p>const text = await file.text();</p>
    <p>const data = JSON.parse(text);</p>
    <p>if (!Array.isArray(data.invoices)) throw new Error(&quot;Formato inválido&quot;);</p>
    <p></p>
    <p>let imported = 0;</p>
    <p>data.invoices.forEach((inv) =&gt; {</p>
    <p>if (!findDuplicateInvoice(inv.serie, inv.correlativo, inv.rucProveedor)) {</p>
    <p>state.invoices.push(inv);</p>
    <p>imported++;</p>
    <p>}</p>
    <p>});</p>
    <p>if (data.validation) state.validation = data.validation;</p>
    <p>if (state.validation) reRunLastValidation(true);</p>
    <p></p>
    <p>await persistState();</p>
    <p>renderAll();</p>
    <p>showAlert(&quot;success&quot;, `Importación completada: se añadieron ${imported} facturas nuevas (los duplicados fueron omitidos automáticamente).`);</p>
    <p>} catch (err) {</p>
    <p>showAlert(&quot;error&quot;, &quot;El archivo JSON seleccionado no tiene un formato de respaldo válido.&quot;);</p>
    <p>}</p>
    <p>});</p>
    <p></p>
    <p>function copyAppsScriptCode() {</p>
    <p>const code = document.getElementById(&quot;appsScriptSnippet&quot;).textContent;</p>
    <p>if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {</p>
    <p>navigator.clipboard.writeText(code).then(() =&gt; {</p>
    <p>showAlert(&quot;success&quot;, &quot;Código de Google Apps Script copiado al portapapeles.&quot;);</p>
    <p>});</p>
    <p>} else {</p>
    <p>const ta = document.createElement(&quot;textarea&quot;);</p>
    <p>ta.value = code;</p>
    <p>document.body.appendChild(ta);</p>
    <p>ta.select();</p>
    <p>document.execCommand(&quot;copy&quot;);</p>
    <p>document.body.removeChild(ta);</p>
    <p>showAlert(&quot;success&quot;, &quot;Código de Google Apps Script copiado al portapapeles.&quot;);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>// =========================================================================</p>
    <p>// 10. NAVEGACIÓN, ALERTAS E INICIALIZACIÓN INMEDIATA</p>
    <p>// =========================================================================</p>
    <p>function switchTab(tabName) {</p>
    <p>document.querySelectorAll(&quot;.nav-tab&quot;).forEach((btn) =&gt; {</p>
    <p>btn.classList.toggle(&quot;active&quot;, btn.dataset.tab === tabName);</p>
    <p>});</p>
    <p>document.querySelectorAll(&quot;.view-section&quot;).forEach((sec) =&gt; {</p>
    <p>sec.classList.toggle(&quot;active&quot;, sec.id === `view-${tabName}`);</p>
    <p>});</p>
    <p>}</p>
    <p></p>
    <p>function showAlert(type, message) {</p>
    <p>const stack = document.getElementById(&quot;alertStack&quot;);</p>
    <p>const div = document.createElement(&quot;div&quot;);</p>
    <p>div.className = `alert-box ${type}`;</p>
    <p>div.innerHTML = `</p>
    <p>&lt;div&gt;${message}&lt;/div&gt;</p>
    <p>&lt;button type=&quot;button&quot; class=&quot;alert-close&quot; onclick=&quot;this.parentElement.remove()&quot;&gt;&amp;times;&lt;/button&gt;</p>
    <p>`;</p>
    <p>stack.prepend(div);</p>
    <p>if (type === &quot;success&quot;) {</p>
    <p>setTimeout(() =&gt; { if (div.parentElement) div.remove(); }, 7000);</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>function updateHeaderAndBadges() {</p>
    <p>const company = state.settings.companyName || &quot;Suministros ElectricOz&quot;;</p>
    <p>document.getElementById(&quot;headerCompanyTitle&quot;).textContent = `${company} — Archivo de Compras SUNAT`;</p>
    <p>document.getElementById(&quot;badgeTotalDocs&quot;).textContent = state.invoices.length;</p>
    <p></p>
    <p>const missingBadge = document.getElementById(&quot;badgeMissingDocs&quot;);</p>
    <p>if (!state.validation) {</p>
    <p>missingBadge.textContent = &quot;Sin validar&quot;;</p>
    <p>missingBadge.className = &quot;tab-badge&quot;;</p>
    <p>} else if (state.validation.missingCount &gt; 0) {</p>
    <p>missingBadge.textContent = `Faltan ${state.validation.missingCount}`;</p>
    <p>missingBadge.className = &quot;tab-badge alert&quot;;</p>
    <p>} else {</p>
    <p>missingBadge.textContent = &quot;100% OK&quot;;</p>
    <p>missingBadge.className = &quot;tab-badge&quot;;</p>
    <p>}</p>
    <p></p>
    <p>const dot = document.getElementById(&quot;syncStatusDot&quot;);</p>
    <p>const txt = document.getElementById(&quot;syncStatusText&quot;);</p>
    <p>const btnQuick = document.getElementById(&quot;btnQuickSync&quot;);</p>
    <p>if (state.settings.syncUrl) {</p>
    <p>dot.className = &quot;dot online&quot;;</p>
    <p>txt.textContent = `Conectado (${state.settings.userName})`;</p>
    <p>btnQuick.style.display = &quot;inline-flex&quot;;</p>
    <p>} else {</p>
    <p>dot.className = &quot;dot&quot;;</p>
    <p>txt.textContent = &quot;Modo Local (Configurar enlace)&quot;;</p>
    <p>btnQuick.style.display = &quot;none&quot;;</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>function renderAll() {</p>
    <p>updateHeaderAndBadges();</p>
    <p>if (state.selectedMonthKey) {</p>
    <p>renderMonthDetailTable();</p>
    <p>} else {</p>
    <p>renderMonthsGrid();</p>
    <p>}</p>
    <p>renderValidationSection();</p>
    <p>}</p>
    <p></p>
    <p>async function initApp() {</p>
    <p>renderAll();</p>
    <p>try {</p>
    <p>const savedInvoices = await dbGet(&quot;invoices&quot;);</p>
    <p>const savedValidation = await dbGet(&quot;validation&quot;);</p>
    <p>const savedSettings = await dbGet(&quot;settings&quot;);</p>
    <p></p>
    <p>if (Array.isArray(savedInvoices)) state.invoices = savedInvoices;</p>
    <p>if (savedValidation) state.validation = savedValidation;</p>
    <p>if (savedSettings) state.settings = { ...state.settings, ...savedSettings };</p>
    <p></p>
    <p>document.getElementById(&quot;cfgCompanyName&quot;).value = state.settings.companyName || &quot;&quot;;</p>
    <p>document.getElementById(&quot;cfgUserName&quot;).value = state.settings.userName || &quot;&quot;;</p>
    <p>document.getElementById(&quot;cfgSyncUrl&quot;).value = state.settings.syncUrl || &quot;&quot;;</p>
    <p></p>
    <p>renderAll();</p>
    <p></p>
    <p>if (state.settings.syncUrl) {</p>
    <p>syncWithCloud(false);</p>
    <p>}</p>
    <p>} catch (e) {</p>
    <p>console.error(&quot;Error inicializando almacenamiento:&quot;, e);</p>
    <p>renderAll();</p>
    <p>}</p>
    <p>}</p>
    <p></p>
    <p>initApp();</p>
    <p>&lt;/script&gt;</p>
    <p>&lt;/body&gt;</p>
    <p>&lt;/html&gt;</p>
